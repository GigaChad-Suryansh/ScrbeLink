# Copy to .env for local work. Never commit the real values.

# Required in production, 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Comma-separated phone numbers (+91...) allowed to sign in as admin.
ADMIN_PHONES=

# Secret the platform cron sends in the x-cron-secret header (16+ characters).
CRON_SECRET=

# Front-end origins allowed to call the API, comma separated.
CORS_ORIGINS=https://your-frontend.example.com

# Optional: only accept evidence links from these hosts (and their subdomains).
MEDIA_HOSTS=storage.scribelink.in

# Set to the number of reverse proxies in front of the API (1 on most hosts) so rate
# limits see the real client address instead of the proxy.
TRUST_PROXY=1

# Demo switches. Leave unset in a real launch.
# DEMO_OTP=true               returns login codes in the response (no SMS provider yet)
# ALLOW_TEST_PAYMENTS=true    accepts fake UPI payments (no real gateway yet)

# Where uploaded sample photos and evidence videos are stored. Use a persistent disk in production.
# UPLOAD_DIR=/data/uploads

# Adds sample scribes, an order and a dispute so admin screens are not empty. Never in production.
# SEED_DEMO=true

PORT=4000

# Database. Set DATABASE_URL for production Postgres; leave empty to use the built-in file database.
DATABASE_URL=
PGLITE_DIR=.data/pglite
