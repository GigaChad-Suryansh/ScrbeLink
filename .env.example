# Copy to .env for local work. Never commit the real values.

# Required in production, 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Comma-separated phone numbers (+91...) allowed to sign in as admin.
ADMIN_PHONES=

# Secret the platform cron sends in the x-cron-secret header (16+ characters).
CRON_SECRET=

# Front-end origins allowed to call the API, comma separated.
CORS_ORIGINS=https://your-frontend.example.com

# Optional: only accept evidence links from these hosts (and their subdomains).
MEDIA_HOSTS=storage.scribelink.in

# Set to the number of reverse proxies in front of the API (1 on most hosts) so rate
# limits see the real client address instead of the proxy.
TRUST_PROXY=1

# Demo switches. Leave unset in a real launch.
# DEMO_OTP=true               returns login codes in the response (no SMS provider yet)
# ALLOW_TEST_PAYMENTS=true    accepts fake UPI payments (no real gateway yet)

# Where uploaded sample photos and evidence videos are stored. Use a persistent disk in production.
# UPLOAD_DIR=/data/uploads

# Adds sample scribes, an order and a dispute so admin screens are not empty. Never in production.
# SEED_DEMO=true

PORT=4000

# Database. Set DATABASE_URL for production Postgres; leave empty to use the built-in file database.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Payments. Leave PAYMENT_PROVIDER as "test" until Razorpay is set up (test mode only, no real money).
PAYMENT_PROVIDER=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Printed on invoices. With a GSTIN the document is titled "Tax invoice"; without one it is a "Receipt".
# Confirm the GST rate and wording with an accountant before launch.
BUSINESS_NAME=ScribeLink
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
GST_RATE=18

# Courier: manual = admin books Porter by hand and sends the rider a link (default in production); simulated = demo only
COURIER_PROVIDER=simulated
# Public address of the web app, used to build rider links
PUBLIC_APP_URL=http://localhost:5173

# Phase 19: Redis for shared OTPs, S3/R2 for private uploads, Sentry for error tracking, PAN encryption key
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
SCRIBE_PAN_KEY=
